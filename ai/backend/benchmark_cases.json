    {
      "id": "G14",
      "name": "MOP / Audit Queries",
      "intent": null,
      "cases": [
        {
          "id": "G14-01",
          "query": "show config audit for demo-switch-01",
          "expected_intent": "show_config",
          "expected_device": "demo-switch-01",
          "note": "No dedicated MOP/audit chat feature exists (git_diff/git_history/mop_audit are never-wired app_audit_keywords, presumably a separate frontend Audit tab). Documents current best-effort fallback, not an ideal mapping."
        },
        {
          "id": "G14-02",
          "query": "compare config changes on demo-router-01",
          "expected_intent": "compare_backups",
          "expected_device": "demo-router-01",
          "note": "This one genuinely matches compare_backups's purpose well."
        },
        {
          "id": "G14-03",
          "query": "what changed in the config of demo-router-01 last week?",
          "expected_intent": "show_config",
          "expected_device": "demo-router-01",
          "note": "Arguably should be compare_backups; falls to show_config's broad 'config' keyword instead. Known gap, unbuilt feature area."
        },
        {
          "id": "G14-04",
          "query": "show git diff for demo-router-02",
          "expected_intent": "run_diagnostic",
          "expected_device": "demo-router-02",
          "note": "No git-diff chat feature; falls to the generic 'show ' catch-all. Known gap, unbuilt feature area."
        },
        {
          "id": "G14-05",
          "query": "audit config history of demo-switch-01",
          "expected_intent": "run_audit_config_changes",
          "expected_device": "demo-switch-01",
          "note": "LLM hallucinates a 'run_' prefix on the prompt's documented audit_config_changes intent name; harmless (falls outside agent.py's operational_intents set so no live action is attempted) but worth reconciling naming if this feature is ever built out."
        }
      ]
    },
    {
      "id": "G15",
      "name": "Ambiguous / Edge Cases",
      "intent": null,
      "cases": [
        {
          "id": "G15-01",
          "query": "TOR23",
          "expected_intent": "unregistered_device",
          "note": "Looks device-shaped but isn't a full registered hostname — correctly flagged not-found rather than guessed at"
        },
        {
          "id": "G15-02",
          "query": "show me everything",
          "expected_intent": "general_chat",
          "note": "vague, no device or clear intent"
        },
        {
          "id": "G15-03",
          "query": "monitor demo-switch-01",
          "expected_intent": "run_healthcheck",
          "expected_device": "demo-switch-01",
          "note": "Genuinely ambiguous — 'monitor' could mean healthcheck or an automated monitoring flow. Small classifier model currently guesses run_automation. Known LLM-judgment gap, not a deterministic bug."
        },
        {
          "id": "G15-04",
          "query": "backup and health check demo-router-01",
          "expected_intent": "run_backup",
          "expected_device": "demo-router-01",
          "note": "multi-action: first verb wins or backup takes priority"
        },
        {
          "id": "G15-05",
          "query": "is OSPF stable on demo-router-01?",
          "expected_intent": "analyze_logs",
          "expected_device": "demo-router-01",
          "note": "diagnostic question about a device"
        },
        {
          "id": "G15-06",
          "query": "share OSPF configuration examples for Cisco IOS XR",
          "expected_intent": "general_chat",
          "note": "Real user-reported bug (2026-07-12): names a vendor/platform, not a registered device — was matching show_config's 'config' substring-in-'configuration' keyword, then falling back to a device carried over from conversation history, giving a wrong device's 'no backup found' error for what's actually a documentation question."
        },
        {
          "id": "G15-07",
          "query": "show me a sample BGP configuration for Juniper",
          "expected_intent": "general_chat",
          "note": "Same bug pattern as G15-06 via run_diagnostic's 'show ' keyword instead of show_config's 'config' keyword."
        }
      ]
