server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Use Docker's internal DNS resolver so upstream hostnames are re-resolved
    # after container restarts (prevents stale IP caching).
    resolver 127.0.0.11 valid=10s ipv6=off;

    location /api/ {
        set $upstream http://topology-backend:8001;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Api-Key "$APP_PASSWORD";
    }

    location / {
        try_files $uri $uri/ /index.html;
        # Prevent caching of index.html so updates are loaded immediately
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
    }
}
